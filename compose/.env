# Stack configuration. APP_BRANCH selects which legacy-goat branch is mounted (main|vulnerable|fixed).
APP_SRC=../../legacy-goat
APP_BRANCH=fixed

GATEWAY_PORT=8080

# SQL ledger. PostgreSQL; db/db2 describes running it on IBM Db2 Community instead.
SQLDB_IMAGE=docker.io/library/postgres:16
SQL_PORT=5432
SQL_DBNAME=ledger
SQL_USER=goat
# Lab-only credential for the containerized SQL engine; not a real secret and never leaves the lab.
SQL_PASSWORD=labpass
