# baseline profile — safe config across the board (the default).
# Under this profile the config-gated vulnerabilities are present-but-unexploitable (hard negatives).
APP_PROFILE=baseline
SESSION_ROAMING=off
HOME_BRANCH_ONLY=on
ALNUM_CUSTOMER_IDS=off
EXTENDED_TIERS=off
REPORT_ARCHIVE=off
AS_OF_DATES=off
PREFORMATTED_REFS=off
RECEIPT_SUBFOLDERS=off
SIGNON_TRACE=off
PARTNER_PREVIEW=off
CORRESPONDENT_ADVICES=off
RICH_NOTICES=off
REQUIRE_APPROVAL_OVER=10000.00
SESSION_TTL=900
